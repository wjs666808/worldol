[sub_resource type="Resource" id="Item_wolf_claw"]
script = ExtResource("4_item")
display_name = "野狼爪"
item_type = 10
price = 20
strength_bonus = 2
agility_bonus = 1
description = "野狼的利爪,蕴含野兽之力"

[sub_resource type="Resource" id="Item_goblin_sword"]
