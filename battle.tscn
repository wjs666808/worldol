level = 3
strength = 13
intelligence = 8
perception = 8
agility = 10
constitution = 12
gold_reward = 40
loot_items = [SubResource("Item_goblin_sword")]

[node name="Battle" type="Node"]
script = ExtResource("2_battle")
player_skills = []
enemy_wave = [SubResource("Enemy_slime"), SubResource("Enemy_wolf"), SubResource("Enemy_goblin")]

[node name="Inventory" type="Node" parent="."]
script = ExtResource("5_inv")

[node name="BackpackUI" type="CanvasLayer" parent="Inventory"]
layer = 10
visible = false

[node name="Panel" type="PanelContainer" parent="Inventory/BackpackUI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260
offset_top = -270
offset_right = 260
offset_bottom = 270
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Inventory/BackpackUI/Panel"]
